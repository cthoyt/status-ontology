ontology: statuso
property_value: dcterms:creator orcid:0000-0003-4423-4370
property_value: dcterms:description "An ontology for the many axes by which a project (whether software, data, etc.) can be judged." xsd:string
property_value: dcterms:license spdx:CC-BY-4.0
property_value: dcterms:title "Project Status Ontology" xsd:string
property_value: IAO:0000700 STATUSO:0000001
property_value: IAO:0000700 STATUSO:0000016
property_value: seeAlso "https://explorism.net/2024/12/04/open-source-activity-check/" xsd:anyURI
property_value: seeAlso "https://obofoundry.org/docs/OntologyStatus.html" xsd:anyURI

[Term]
id: STATUSO:0000001
name: project
