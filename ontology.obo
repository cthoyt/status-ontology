ontology: statuso
property_value: IAO:0000700 STATUSO:0000001
property_value: IAO:0000700 STATUSO:0000016
property_value: dcterms:title "Project Status Ontology" xsd:string
property_value: dcterms:description "An ontology for the many axes by which a project (whether software, data, etc.) can be judged." xsd:string
property_value: dcterms:creator orcid:0000-0003-4423-4370
property_value: rdfs:seeAlso "https://explorism.net/2024/12/04/open-source-activity-check/" xsd:anyURI

[Typedef]
id: IAO:0000700
name: has ontology root term
is_metadata_tag: true

[Term]
id: STATUSO:0000001
name: project
xref: http://usefulinc.com/ns/doap#Project

[Term]
id: STATUSO:0000002
name: project by responsiveness
is_a: STATUSO:0000001 ! project

[Term]
id: STATUSO:0000003
name: project that is responsive
is_a: STATUSO:0000002 ! project by responsiveness
disjoint_from: STATUSO:0000004 ! project that is not responsive

[Term]
id: STATUSO:0000004
name: project that is not responsive
is_a: STATUSO:0000002 ! project by responsiveness

[Term]
id: STATUSO:0000005
name: project by contact transparency
is_a: STATUSO:0000001 ! project

[Term]
id: STATUSO:0000006
name: project with transparent contact
def: "A project whose responsible person can both be identified (e.g., with a persistent identifier) and contacted (e.g., via email, GitHub)"
is_a: STATUSO:0000005 ! project by contact transparency
intersection_of: STATUSO:0000020 ! project with a dereferencable maintainer
intersection_of: STATUSO:0000023 ! project with a contactable maintainer
disjoint_from: STATUSO:0000007 ! project without transparent contact

[Term]
id: STATUSO:0000007
name: project without transparent contact
is_a: STATUSO:0000005 ! project by contact transparency

[Term]
id: STATUSO:0000008
name: project by development activity
is_a: STATUSO:0000028 ! project by activity

[Term]
id: STATUSO:0000009
name: project is actively developed
is_a: STATUSO:0000008 ! project by development activity
disjoint_from: STATUSO:0000010 ! project is not actively developed

[Term]
id: STATUSO:0000010
name: project is not actively developed
is_a: STATUSO:0000008 ! project by development activity

[Term]
