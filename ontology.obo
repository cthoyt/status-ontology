[Term]
id: STATUSO:0000013
name: inactive project
intersection_of: STATUSO:0000003 ! project that is responsive
intersection_of: STATUSO:0000010 ! project is not actively developed
is_a: STATUSO:0000011 ! project by high-level classification

[Term]
id: STATUSO:0000014
name: orphaned project
