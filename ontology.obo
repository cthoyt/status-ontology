[Term]
id: STATUSO:0000019
name: project by maintainer dereferencability
is_a: STATUSO:0000001 ! project

[Term]
id: STATUSO:0000020
name: project with a dereferencable maintainer
def: "A project whose responsible person can both be identified (e.g., with a persistent identifier). A project that only lists the name of the responsible person is not sufficient."
is_a: STATUSO:0000019 ! project by maintainer dereferencability
disjoint_from: STATUSO:0000021

[Term]
id: STATUSO:0000021
name: project without a dereferencable maintainer
def: "A project whose responsible person can not both be identified (e.g., with a persistent identifier)."
is_a: STATUSO:0000019 ! project by maintainer dereferencability

[Term]
id: STATUSO:0000022
name: project by maintainer contactability
is_a: STATUSO:0000001 ! project

[Term]
id: STATUSO:0000023
name: project with a contactable maintainer
def: "A project whose responsible person can both be contacted (e.g., by email or GitHub)."
is_a: STATUSO:0000022 ! project by maintainer contactability
disjoint_from: STATUSO:0000024

[Term]
id: STATUSO:0000024
name: project without a contactable maintainer
